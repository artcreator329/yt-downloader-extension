#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/../../.." && pwd )"
cd "$DIR"

# Check if server is already running
if curl -s http://127.0.0.1:8989/status >/dev/null 2>&1; then
    osascript -e 'display notification "Engine is already running! Chrome Extension is ready to download." with title "YouTube Downloader"'
    exit 0
fi

# Setup environment if missing
if [ ! -d "$DIR/server/venv" ]; then
    python3 -m venv "$DIR/server/venv"
    "$DIR/server/venv/bin/pip" install -r "$DIR/server/requirements.txt"
fi

# Run server silently in background
LOG_DIR="$HOME/Library/Logs/ytdownloader"
mkdir -p "$LOG_DIR" && chmod 700 "$LOG_DIR"
nohup "$DIR/server/venv/bin/python3" "$DIR/server/server.py" > "$LOG_DIR/engine.log" 2>&1 &

sleep 1
osascript -e 'display notification "Native Engine started in background! Chrome extension is ready." with title "YouTube Downloader"'
