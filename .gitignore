# Python virtual environment and bytecode
server/venv/
__pycache__/
*.pyc

# Local usage analytics: private tooling (names the VPS host and SSH login) and
# log snapshots containing visitors' IP addresses. Never commit any of it.
analytics/

# Build output, regenerated by landing/deploy.py (embeds the extension zip)
landing/worker.js

# Secrets and local environment (deploy.py reads CLOUDFLARE_* from the environment)
.env
.env.*
*.pem
*.key

# Local tooling and OS files
.claude/
.DS_Store
