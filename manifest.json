{
  "manifest_version": 3,
  "name": "YouTube Video Downloader",
  "version": "1.2.1",
  "description": "Native, 100% private YouTube video and audio downloader. Lossless 4K, 1080p, 720p, MP3, and HD thumbnails.",
  "permissions": [
    "activeTab",
    "downloads",
    "downloads.ui",
    "storage",
    "contextMenus"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://ytapi.aigility.digital/*",
    "http://localhost:8989/*",
    "http://127.0.0.1:8989/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
